    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

resource "aws_iam_role" "eks_admin_cli" {
  name        = "eks-admin-cli"
  description = "Created with RoleCraft"

  assume_role_policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_policy" "eks_admin_cli_policy" {
  name        = "eks-admin-cli-policy"
  description = "Created with RoleCraft"

  policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EksKubectlCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:*:*:cluster/prod"
    },
    {
      "Sid": "EksKubectlList",
      "Effect": "Allow",
      "Action": "eks:ListClusters",
      "Resource": "*"
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_role_policy_attachment" "eks_admin_cli_policy" {
  role       = aws_iam_role.eks_admin_cli.name
  policy_arn = aws_iam_policy.eks_admin_cli_policy.arn
}

# EC2 instances use roles through an instance profile.
resource "aws_iam_instance_profile" "eks_admin_cli" {
  name = "eks-admin-cli"
  role = aws_iam_role.eks_admin_cli.name
}

# Give kubectl access to your EKS cluster(s) through EKS access entries.
# The cluster's authentication mode must be API or API_AND_CONFIG_MAP for access entries.
# Change AmazonEKSViewPolicy to AmazonEKSEditPolicy or AmazonEKSClusterAdminPolicy if more access is needed.
resource "aws_eks_access_entry" "eks_admin_cli_eks_1" {
  cluster_name  = "prod"
  principal_arn = aws_iam_role.eks_admin_cli.arn
}

resource "aws_eks_access_policy_association" "eks_admin_cli_eks_1_view" {
  cluster_name  = "prod"
  principal_arn = aws_iam_role.eks_admin_cli.arn
  policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSViewPolicy"

  access_scope {
    type = "cluster"
  }

  depends_on = [aws_eks_access_entry.eks_admin_cli_eks_1]
}

output "role_arn" {
  value = aws_iam_role.eks_admin_cli.arn
}
