# Generated by RoleCraft — https://rolecraft.omhinge.cloud
# Creates an IAM role with its trust policy and permissions.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
  }
}

resource "aws_iam_role" "ec2_ops" {
  name        = "ec2-ops"
  description = "Created with RoleCraft"

  assume_role_policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_policy" "ec2_ops_policy" {
  name        = "ec2-ops-policy"
  description = "Created with RoleCraft"

  policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2StartStopView",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstances",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2StartStopManage",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Env": "dev"
        }
      }
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_role_policy_attachment" "ec2_ops_policy" {
  role       = aws_iam_role.ec2_ops.name
  policy_arn = aws_iam_policy.ec2_ops_policy.arn
}

resource "aws_iam_role_policy_attachment" "ec2_ops_managed_1" {
  role       = aws_iam_role.ec2_ops.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

# EC2 instances use roles through an instance profile.
resource "aws_iam_instance_profile" "ec2_ops" {
  name = "ec2-ops"
  role = aws_iam_role.ec2_ops.name
}

output "role_arn" {
  value = aws_iam_role.ec2_ops.arn
}
