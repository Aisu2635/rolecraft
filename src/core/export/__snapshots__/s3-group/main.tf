# Generated by RoleCraft — https://rolecraft.omhinge.cloud
# Creates a permissions policy and attaches it to an existing IAM group.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.81, < 7.0"
    }
  }
}

# IAM is global; this region only selects the API endpoint Terraform calls.
provider "aws" {
  region = "us-east-1"
}

resource "aws_iam_policy" "analytics_reader_policy" {
  name        = "analytics-reader-policy"
  description = "Created with RoleCraft"

  policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListReadList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::data-lake",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "reports/",
            "reports/*"
          ]
        }
      }
    },
    {
      "Sid": "S3ListReadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::data-lake/reports/*"
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_group_policy_attachment" "analytics_reader_policy" {
  group      = "analytics-team"
  policy_arn = aws_iam_policy.analytics_reader_policy.arn
}

output "policy_arn" {
  value = aws_iam_policy.analytics_reader_policy.arn
}
