# Generated by RoleCraft — https://rolecraft.omhinge.cloud
# Creates a permissions policy and attaches it to an existing IAM user.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.81, < 7.0"
    }
  }
}

provider "aws" {
  region = "eu-west-1"
}

resource "aws_iam_policy" "deploy_bot_kubectl_policy" {
  name        = "deploy-bot-kubectl-policy"
  description = "Created with RoleCraft"

  policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EksKubectlCluster",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": "arn:aws:eks:eu-west-1:*:cluster/prod"
    },
    {
      "Sid": "EksKubectlList",
      "Effect": "Allow",
      "Action": "eks:ListClusters",
      "Resource": "*"
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_user_policy_attachment" "deploy_bot_kubectl_policy" {
  user       = "deploy-bot"
  policy_arn = aws_iam_policy.deploy_bot_kubectl_policy.arn
}

# Give kubectl access to your EKS cluster(s) through EKS access entries.
# The cluster's authentication mode must be API or API_AND_CONFIG_MAP for access entries.
# Change AmazonEKSViewPolicy to AmazonEKSEditPolicy or AmazonEKSClusterAdminPolicy if more access is needed.
data "aws_iam_user" "deploy_bot" {
  user_name = "deploy-bot"
}

resource "aws_eks_access_entry" "deploy_bot_kubectl_eks_1" {
  cluster_name  = "prod"
  principal_arn = data.aws_iam_user.deploy_bot.arn
}

resource "aws_eks_access_policy_association" "deploy_bot_kubectl_eks_1_view" {
  cluster_name  = "prod"
  principal_arn = data.aws_iam_user.deploy_bot.arn
  policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSViewPolicy"

  access_scope {
    type = "cluster"
  }

  depends_on = [aws_eks_access_entry.deploy_bot_kubectl_eks_1]
}

output "policy_arn" {
  value = aws_iam_policy.deploy_bot_kubectl_policy.arn
}
