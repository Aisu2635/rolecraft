# Generated by RoleCraft — https://rolecraft.omhinge.cloud
# Creates an IAM role with its trust policy and permissions.

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.81, < 7.0"
    }
  }
}

# IAM is global; this region only selects the API endpoint Terraform calls.
provider "aws" {
  region = "us-east-1"
}

# Uncomment if your account doesn't have the GitHub OIDC provider yet.
# Then also add depends_on = [aws_iam_openid_connect_provider.github] to aws_iam_role.github_deploy.
# resource "aws_iam_openid_connect_provider" "github" {
#   url            = "https://token.actions.githubusercontent.com"
#   client_id_list = ["sts.amazonaws.com"]
# }

# The plan stops (precondition on the role) if these credentials aren't for the trust policy's account.
data "aws_caller_identity" "current" {}

resource "aws_iam_role" "github_deploy" {
  name        = "github-deploy"
  description = "Created with RoleCraft"

  assume_role_policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:omhinge/site:ref:refs/heads/main"
        }
      }
    }
  ]
}
ROLECRAFT_JSON

  lifecycle {
    precondition {
      condition     = data.aws_caller_identity.current.account_id == "123456789012"
      error_message = "The trust policy trusts GitHub through account 123456789012's OIDC provider: apply this with credentials for account 123456789012."
    }
  }
}

resource "aws_iam_policy" "github_deploy_policy" {
  name        = "github-deploy-policy"
  description = "Created with RoleCraft"

  policy = <<-ROLECRAFT_JSON
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadWriteList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::site-assets"
    },
    {
      "Sid": "S3ReadWriteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::site-assets/*"
    },
    {
      "Sid": "CloudfrontCustomScoped",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::123456789012:distribution/E2EXAMPLE"
    }
  ]
}
ROLECRAFT_JSON
}

resource "aws_iam_role_policy_attachment" "github_deploy_policy" {
  role       = aws_iam_role.github_deploy.name
  policy_arn = aws_iam_policy.github_deploy_policy.arn
}

output "role_arn" {
  value = aws_iam_role.github_deploy.arn
}
